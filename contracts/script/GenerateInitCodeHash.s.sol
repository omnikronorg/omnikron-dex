pragma solidity 0.8.36;

import { Script, console2 } from "forge-std/Script.sol";
import { Pair } from "../src/core/Pair.sol";

contract GenerateInitCodeHash is Script {
    function run() external {
        bytes32 initCodeHash = keccak256(type(Pair).creationCode);

        string memory fileContent = string.concat(
            "// SPDX-License-Identifier: MIT\n",
            "pragma solidity 0.8.36;\n\n",
            "// AUTO-GENERATED by script/GenerateInitCodeHash.s.sol -- do not edit manually.\n",
            "// Run the script whenever the bytecode of Pair.sol changes.\n",
            "library PairInitCode {\n",
            "    bytes32 internal constant HASH = ", vm.toString(initCodeHash), ";\n",
            "}\n"
        );

        vm.writeFile("src/periphery/libraries/PairInitCode.sol", fileContent);

        console2.log("INIT_CODE_HASH atualizado:");
        console2.logBytes32(initCodeHash);
    }
}
